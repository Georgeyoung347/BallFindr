<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme (manifest <application android:theme>). BridgeActivity swaps the
         application and activity theme to AppTheme.NoActionBar in onCreate, so this mostly
         feeds the brand colours to AppCompat widgets and the pre-Android 15 status bar
         (colorPrimaryDark). -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <!-- Theme the WebView activity runs under. DayNight is kept on purpose so native UI drawn
         by the system/WebView (select dropdowns, date pickers, file chooser, alerts) follows
         the device setting; the site itself handles its own light/dark theme.
         The window background is pinned to the brand dark colour in BOTH modes so nothing
         white is ever visible behind the WebView (startup, keyboard transitions, splash
         fade-out); capacitor.config.ts sets the same colour on the WebView. -->
    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <item name="android:windowBackground">@color/brand_background</item>
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <!-- Launch theme (manifest <activity android:theme>). On Android 12+ the system draws the
         splash from the windowSplashScreen* attributes; on older versions the AndroidX
         core-splashscreen compat layer draws the same background + icon into the starting
         window. Without an explicit background it falls back to the device theme's
         colorBackground, i.e. white on light-mode devices, which is the white flash this
         fixes. @drawable/splash (generated by @capacitor/assets, incl. -night/-land variants)
         stays referenced for the Capacitor plugin's own fallback path and SplashScreen.show(). -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@drawable/splash</item>
        <item name="windowSplashScreenBackground">@color/brand_background</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
    </style>
</resources>
